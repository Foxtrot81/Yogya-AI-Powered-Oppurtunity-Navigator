# =========================================================
# Yogya Pipeline Environment Configuration Example
# Copy this file to .env and configure local credentials
# =========================================================

# LLM Provider Configuration ("gemini", "openai", or "none")
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Google Gemini API Key (Required only if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI API Key (Required only if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# PostgreSQL Database Configuration (Optional for local testing; required for live import)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yogya_db
DB_USER=postgres
DB_PASSWORD=
DATABASE_URL=postgresql://postgres:password@localhost:5432/yogya_db

# Pipeline Operational Settings
YOGYA_DATA_ENV=development
PIPELINE_LOG_LEVEL=INFO
ENABLE_DRY_RUN=false
